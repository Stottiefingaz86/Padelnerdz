{
  "expo": {
    "name": "Padel Nerdz",
    "slug": "padel-nerdz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "padelnerdz",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.padelnerdz.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Padel Nerdz uses your contacts so you can invite padel friends like WhatsApp.",
        "NSPhotoLibraryUsageDescription": "Padel Nerdz lets you share padel photos and videos in session chat.",
        "NSCameraUsageDescription": "Padel Nerdz lets you capture moments to share in session chat.",
        "NSLocationWhenInUseUsageDescription": "Padel Nerdz uses your location to show padel groups near you.",
        "NSFaceIDUsageDescription": "Padel Nerdz can lock the app behind Face ID so only you open your chats and mix-ins.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.padelnerdz.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_CONTACTS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "notification": {
      "color": "#C8FF2E"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1115"
        }
      ],
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Padel Nerdz uses your contacts so you can invite padel friends like WhatsApp."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Padel Nerdz lets you share padel photos and videos in session chat.",
          "cameraPermission": "Padel Nerdz lets you capture moments to share in session chat."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Padel Nerdz uses your location to show padel groups near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8FF2E",
          "sounds": []
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12644e8d-bb39-44dd-9a86-605fe79b78af"
      }
    },
    "owner": "padelnerdz"
  }
}
