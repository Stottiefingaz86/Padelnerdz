EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy anon JWT or new sb_publishable_… key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# PostHog (EU). Leave blank to disable. Prefer a dedicated Padel Nerdz project.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Admin back office URL (opened from /owner)
EXPO_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# Stripe Connect (publishable key only — secret stays in Supabase Edge secrets)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
# Also set on Supabase: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# See docs/STRIPE_CONNECT.md

# Twilio secrets go in Supabase Auth → Phone (Twilio Verify), NOT here.
# See docs/TWILIO_SETUP.md
#
# Local phone accounts WITHOUT SMS — solo device demos ONLY.
# Keep unset/false when inviting real friends (beta). Requires Twilio.
# EXPO_PUBLIC_ALLOW_LOCAL_PHONE_FALLBACK=true
